# Database — PostgreSQL via Neon or Supabase
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vivah?sslmode=require"
DATABASE_URL_TEST="postgresql://USER:PASSWORD@HOST:5432/vivah_test?sslmode=require"

# Next Auth (v5 — AUTH_ prefix)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Setup secret for the /api/auth/register endpoint (change after first use)
ADMIN_SECRET="vivah-setup-2026"

# Cloudinary (Gallery / Document uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Sentry (Error monitoring)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEDDING_DATE="2026-11-25"
